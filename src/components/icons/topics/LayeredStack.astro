---
interface Props {
  size?: number
  id?: string
  class?: string
}

const { size = 24, ...props } = Astro.props
---

<svg
  xmlns='http://www.w3.org/2000/svg'
  width={size}
  height={size}
  viewBox='0 0 24 24'
  fill='none'
  stroke='currentColor'
  stroke-width='2'
  stroke-linejoin='round'
  {...props}
>
  <polygon points='12 2 21 7 12 12 3 7'></polygon>
  <polyline points='3 11 12 16 21 11'></polyline>
  <polyline points='3 15 12 20 21 15'></polyline>
</svg>
