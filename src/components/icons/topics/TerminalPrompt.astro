---
interface Props {
  size?: number
  id?: string
  class?: string
}

const { size = 24, ...props } = Astro.props
---

<svg
  xmlns='http://www.w3.org/2000/svg'
  width={size}
  height={size}
  viewBox='0 0 24 24'
  fill='none'
  stroke='currentColor'
  stroke-width='2'
  stroke-linecap='round'
  stroke-linejoin='round'
  {...props}
>
  <polyline points='4 6 10 12 4 18'></polyline>
  <line x1='12' y1='18' x2='20' y2='18'></line>
</svg>
