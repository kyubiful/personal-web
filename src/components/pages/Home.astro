---
import { getLangFromUrl, useTranslations } from '@/i18n/utils'
import Layout from '@/layouts/Layout.astro'
import ContentLayout from '@/layouts/ContentLayout.astro'
import Hero from '@/components/home/Hero.astro'
import AboutMe from '@/components/home/AboutMe.astro'
import Exprience from '@/components/home/Exprience.astro'
import Certifications from '@/components/home/Certifications.astro'
import Projects from '@/components/home/Projects.astro'
import Skills from '@/components//home/Skills.astro'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const description = t('meta.home.description') as string
const ogImage = new URL('/sergio.webp', Astro.site).toString()
const ogUrl = new URL(Astro.url.pathname, Astro.site).toString()

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: 'Sergio Zabala Muñoz',
      url: Astro.site?.toString(),
      sameAs: [
        'https://linkedin.com/in/sergio-zabala-muñoz',
        'https://github.com/kyubiful'
      ]
    },
    {
      '@type': 'WebSite',
      name: 'Sergio Zabala Muñoz',
      url: Astro.site?.toString()
    }
  ]
}
---

<Layout title={t('nav.home') as string} description={description} lang={lang}>
  <Fragment slot='head'>
    <meta property='og:title' content='Sergio Zabala Muñoz' />
    <meta property='og:description' content={description} />
    <meta property='og:type' content='website' />
    <meta property='og:url' content={ogUrl} />
    <meta property='og:image' content={ogImage} />

    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content='Sergio Zabala Muñoz' />
    <meta name='twitter:description' content={description} />
    <meta name='twitter:image' content={ogImage} />

    <script
      type='application/ld+json'
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />
  </Fragment>
  <ContentLayout>
    <Hero />
    <AboutMe />
    <Exprience />
    <Certifications />
    <Projects />
    <Skills />
  </ContentLayout>
</Layout>
