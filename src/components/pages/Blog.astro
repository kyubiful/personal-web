---
import Layout from '@/layouts/Layout.astro'
import { getLangFromUrl, useTranslations } from '@/i18n/utils'
import ContentLayout from '@/layouts/ContentLayout.astro'
import Typography from '../ui/Typography.astro'
import Pill from '../ui/Pill.astro'
import TerminalWindow from '../ui/TerminalWindow.astro'
import Pagination from '../ui/Pagination.astro'
import type { PostListItem } from '@/utils/posts'

interface Props {
  posts: PostListItem[]
  currentPage: number
  lastPage: number
  prevUrl: string | null
  nextUrl: string | null
  pageUrls: string[]
}

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const description = t('meta.blog.description') as string
const { posts, currentPage, lastPage, prevUrl, nextUrl, pageUrls } = Astro.props
---

<Layout title='Blog' description={description} lang={lang}>
  <ContentLayout>
    <Typography variant='h1' as='h1' class='text-2xl sm:text-4xl'>
      {t('nav.blog') as string}
    </Typography>
    <ul class='flex flex-col gap-6'>
      {
        posts.map((post, index) => (
          <li>
            <TerminalWindow path={`${post.slug}.md`} bodyClass='p-5 sm:p-7'>
              {currentPage === 1 && index === 0 && (
                <span
                  slot='bar-right'
                  class='text-[10px] font-bold uppercase text-white bg-accent-light dark:bg-accent-dark px-2 py-0.5 rounded shrink-0'
                >
                  Latest
                </span>
              )}
              <article class='flex flex-col gap-4'>
                <Typography variant='h2' as='h2' class='text-2xl sm:text-4xl'>
                  <a
                    href={post.url}
                    transition:name={`post-title-${post.frontmatter.transitionSlug}`}
                  >
                    {post.frontmatter.title}
                  </a>
                </Typography>
                <div
                  class='flex gap-2 flex-wrap'
                  transition:name={`post-pill-${post.frontmatter.transitionSlug}`}
                >
                  {post.frontmatter.tags.map((tag) => (
                    <Pill>{tag}</Pill>
                  ))}
                </div>
                <section
                  class='flex flex-wrap justify-between items-center gap-x-2 gap-y-1'
                  transition:name={`post-date-${post.frontmatter.transitionSlug}`}
                >
                  <Typography variant='p' as='p' class='capitalize'>
                    {post.frontmatter.pubDate.toLocaleString(
                      lang === 'en' ? 'en-US' : 'es-ES',
                      { day: 'numeric', month: 'short', year: 'numeric' }
                    )}
                    - {post.frontmatter.author}
                  </Typography>
                  <a
                    href={post.url}
                    class='text-xs text-accent-light dark:text-accent-dark hover:translate-x-0.5 transition-transform'
                  >
                    read →
                  </a>
                </section>
              </article>
            </TerminalWindow>
          </li>
        ))
      }
    </ul>
    <Pagination
      currentPage={currentPage}
      lastPage={lastPage}
      prevUrl={prevUrl}
      nextUrl={nextUrl}
      pageUrls={pageUrls}
    />
  </ContentLayout>
  <script is:inline data-astro-rerun>
    ;(() => {
      sessionStorage.setItem('blog:lastPage', window.location.pathname)
    })()
  </script>
</Layout>
