---
import Typography from '@/components/ui/Typography.astro'
import TerminalWindow from '@/components/ui/TerminalWindow.astro'
import GithubIcon from '@/components/icons/Github.astro'
import LinkedInIcon from '@/components/icons/LinkedIn.astro'
import MessageIcon from '@/components/icons/Message.astro'

import { getLangFromUrl, useTranslations } from '@/i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<TerminalWindow path='~/sergio.sh' bodyClass='p-6'>
  <div
    class='flex flex-col-reverse md:flex-row justify-between gap-6 md:items-center'
  >
    <div class='flex flex-col gap-2'>
      <p class='text-xs'>
        <span class='text-accent-light dark:text-accent-dark font-bold'>$</span> whoami
      </p>
      <Typography as='h1' variant='h3' color='black'>
        Sergio Zabala Muñoz
      </Typography>
      <p class='text-xs mt-2'>
        <span class='text-accent-light dark:text-accent-dark font-bold'>$</span> cat
        role.txt
      </p>
      <Typography
        as='h2'
        variant='p'
        color='black'
        class='text-balance text-sm'
      >
        {t('hero.description')}
      </Typography>
      <ul class='text-sm flex gap-2 mt-2'>
        <li>
          <a
            href='mailto:sergio.zabala@gmail.com'
            class='hover:scale-110 transition-all block border-2 border-gray-800 dark:border-gray-100 rounded-md p-1'
            aria-label={t('hero.mail.arialabel') as string}
          >
            <MessageIcon size={16} />
          </a>
        </li>
        <li>
          <a
            href='https://linkedin.com/in/sergio-zabala-muñoz'
            target='_blank'
            rel='noopener noreferrer'
            class='hover:scale-110 transition-all block border-2 border-gray-800 dark:border-gray-100 rounded-md p-1'
            aria-label={t('hero.linkedin.arialabel') as string}
          >
            <LinkedInIcon size={16} />
          </a>
        </li>
        <li>
          <a
            href='https://github.com/kyubiful'
            target='_blank'
            rel='noopener noreferrer'
            class='hover:scale-110 transition-all block border-2 border-gray-800 dark:border-gray-100 rounded-md p-1'
            aria-label={t('hero.github.arialabel') as string}
          >
            <GithubIcon size={16} />
          </a>
        </li>
      </ul>
    </div>
    <img
      src='/sergio.webp'
      class='size-28 md:size-32 rounded-md aspect-square object-cover border-2 border-gray-800 dark:border-gray-100 shrink-0 self-center md:self-auto'
      alt='Sergio Zabala Muñoz'
      loading='lazy'
    />
  </div>
</TerminalWindow>
