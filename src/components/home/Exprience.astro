---
import Typography from '@/components/ui/Typography.astro'
import { getLangFromUrl, useTranslations } from '@/i18n/utils'

interface Job {
  position: string
  company: string
  date: string
  description: string
}

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const jobs = t('experience.jobs') as Job[]
---

<section class='flex flex-col gap-y-1'>
  <Typography as='h2' variant='h3' color='black' class='mb-2'>
    {t('experience.title')}
  </Typography>
  {
    jobs.map((job: any, index: number) => (
      <article class='flex gap-4 py-4 border-t-2 border-gray-800 dark:border-gray-100 last:border-b-2'>
        <span class='text-2xl font-bold text-accent-light dark:text-accent-dark shrink-0'>
          {String(index + 1).padStart(2, '0')}
        </span>
        <div class='flex flex-col gap-2 flex-1'>
          <header>
            <div class='flex flex-col sm:flex-row sm:justify-between sm:items-center gap-1 sm:gap-2'>
              <div class='flex items-center gap-2'>
                <Typography as='h3' variant='h5' color='black'>
                  {job.company}
                </Typography>
                {index === 0 && (
                  <>
                    <span class='size-2 rounded-full bg-[#28c840]' />
                    <Typography
                      as='span'
                      variant='span'
                      color='black'
                      class='text-xs'
                    >
                      {t('experience.current') as string}
                    </Typography>
                  </>
                )}
              </div>
              <Typography
                as='p'
                variant='span'
                color='black'
                class='italic text-xs'
              >
                {job.date}
              </Typography>
            </div>
            <Typography as='p' variant='span' color='black' class='text-xs'>
              {job.position}
            </Typography>
          </header>
          <Typography as='p' variant='p' color='black'>
            {job.description}
          </Typography>
        </div>
      </article>
    ))
  }
</section>
