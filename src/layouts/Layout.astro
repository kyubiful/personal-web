---
import { ClientRouter } from 'astro:transitions'
import Nav from '@/components/navbar/Nav.astro'
import '@/styles/global.css'
import { useTranslatedPath, getCurrentUrl } from '@/i18n/utils'

interface Props {
  title: string
  description: string
  lang: string
}

const { title, description, lang } = Astro.props

const currentUrl = getCurrentUrl(Astro.url)
const translatePathEs = useTranslatedPath('es')
const translatePathEn = useTranslatedPath('en')
const esPath = translatePathEs(currentUrl, 'es')
const enPath = translatePathEn(currentUrl, 'en')
---

<!doctype html>
<html lang={lang ?? 'es'} class='overflow-y-scroll'>
  <head>
    <meta charset='UTF-8' />
    <meta name='description' content={description} />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='generator' content={Astro.generator} />
    <title>{'Sergio Zabala | ' + title}</title>
    <link rel='canonical' href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel='alternate' hreflang='es' href={new URL(esPath, Astro.site)} />
    <link rel='alternate' hreflang='en' href={new URL(enPath, Astro.site)} />
    <link
      rel='alternate'
      hreflang='x-default'
      href={new URL(esPath, Astro.site)}
    />
    <link
      rel='alternate'
      type='application/rss+xml'
      title='Sergio Zabala - Blog (ES)'
      href={new URL('/rss.xml', Astro.site)}
    />
    <link
      rel='alternate'
      type='application/rss+xml'
      title='Sergio Zabala - Blog (EN)'
      href={new URL('/en/rss.xml', Astro.site)}
    />
    <ClientRouter />
    <slot name='head' />
  </head>

  <body
    class='antialiased bg-white text-slate-900 dark:bg-slate-900 dark:text-slate-200 font-mono'
  >
    <Nav />
    <slot />
    <script is:inline>
      function setTheme() {
        if (localStorage.theme === 'dark') {
          document.documentElement.classList.add('dark')
          localStorage.theme = 'dark'
        } else if (localStorage.theme === 'light') {
          document.documentElement.classList.remove('dark')
          localStorage.theme = 'light'
        } else {
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark')
            localStorage.theme = 'dark'
          } else {
            document.documentElement.classList.remove('dark')
            localStorage.theme = 'light'
          }
        }
      }

      setTheme()
      document.addEventListener('astro:after-swap', () => {
        setTheme()
      })
    </script>
  </body>
</html>
