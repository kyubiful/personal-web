---
import BlogPage from '@/components/pages/Blog.astro'
import {
  getPostsByLang,
  getBlogPageUrl,
  getLastPage,
  POSTS_PER_PAGE
} from '@/utils/posts'

const lang = 'en'

const allPosts = await getPostsByLang(lang)
const lastPage = getLastPage(allPosts.length)
const posts = allPosts.slice(0, POSTS_PER_PAGE)
const pageUrls = Array.from({ length: lastPage }, (_, i) =>
  getBlogPageUrl(lang, i + 1)
)
---

<BlogPage
  posts={posts}
  currentPage={1}
  lastPage={lastPage}
  prevUrl={null}
  nextUrl={lastPage > 1 ? getBlogPageUrl(lang, 2) : null}
  pageUrls={pageUrls}
/>
